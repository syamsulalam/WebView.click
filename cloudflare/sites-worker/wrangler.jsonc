{
  "name": "sites-webview-click",
  "account_id": "5076c806dec2b4df072e537f1a09500c",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "SITES_BUCKET",
      "bucket_name": "webview-sites"
    }
  ],
  "routes": [
    {
      "pattern": "sites.webview.click",
      "zone_name": "webview.click",
      "custom_domain": true
    }
  ]
}
