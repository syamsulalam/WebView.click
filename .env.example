# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# R2_PUBLIC_BASE_URL: Public custom domain for the Cloudflare R2 bucket.
R2_PUBLIC_BASE_URL="https://assets.webview.click"

# CLERK AUTH
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Note: All other configurations (API Keys, Payment Links) 
# have been moved to the Database (D1 system_settings table)
# and can be managed via the /admin/settings dashboard.
