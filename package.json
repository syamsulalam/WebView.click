{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.1",
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "browserslist@<=4.28.6": "4.28.7",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-cookie@<=3.0.5": "3.0.7",
      "protobufjs@>=7.0.0 <7.6.5": "7.6.5",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "pnpm run check:syntax && pnpm run test:api-handlers",
    "check:syntax": "node scripts/check-build-syntax.mjs",
    "build": "vite build",
    "build:local-server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:postprocess": "tsx tests/generatedSitePostProcess.test.ts",
    "test:export-parity": "tsx tests/exportSiteParity.test.ts",
    "test:scaffold": "tsx tests/generatedSiteScaffold.test.ts",
    "test:site-generation": "tsx tests/siteGeneration.test.ts",
    "test:generation-job-state": "tsx tests/generationJobState.test.ts",
    "test:site-copy-preserve": "tsx tests/siteCopyOfferingPreserve.test.ts",
    "test:intent-maps": "tsx tests/siteIntentMaps.test.ts",
    "test:preset-inference": "tsx tests/stylePresetInference.test.ts",
    "test:site-history": "tsx tests/siteHistoryBackup.test.ts",
    "test:admin-generation": "tsx tests/adminSiteGeneration.test.ts",
    "test:api-handlers": "tsx --test tests/apiHandlers.test.ts tests/apiAccess.test.ts tests/paypalSettlement.test.ts tests/staticRelease.test.ts tests/generationLease.test.ts",
    "r2:cors": "pnpm --dir cloudflare/sites-worker exec wrangler r2 bucket cors set webview --file ../r2-cors-webview.json --force",
    "r2:cors:list": "pnpm --dir cloudflare/sites-worker exec wrangler r2 bucket cors list webview"
  },
  "dependencies": {
    "@clerk/backend": "3.31.4",
    "@clerk/clerk-react": "^5.61.6",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dompurify": "3.4.18",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
